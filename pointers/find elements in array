
#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    int found = 0;
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int index;
    printf("Enter the element: ");
    scanf("%d",&index);
    int *p = arr;
    for(int i=0;i<n;i++, p++){
        if(index == *p){
            printf("%d\n", i);
            found = 1;
            break;
        }
    }
    if(found == 0){
        printf("-1");
    }
}
