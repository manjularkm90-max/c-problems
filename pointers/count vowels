#include<stdio.h>
int main(){
    char str[100];
    fgets(str,sizeof str,stdin);
    char *p=str;
    int count=0;
    for(int i=0;*p!='\0';p++){
        if(*p=='a'||*p=='e'||*p=='i'|| *p=='o'|| *p=='u'||*p=='A'|| *p=='E'|| *p=='I'|| *p=='O'||*p=='U'){
            count++;
        }
    }
    printf("%d",count);
}
