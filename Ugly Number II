class Solution {
    public int nthUglyNumber(int n) {
        int[] dp = new int[n];
        dp[0] = 1;
        
        int p2 = 0, p3 = 0, p5 = 0;
        int next2 = 2, next3 = 3, next5 = 5;
        
        for (int i = 1; i < n; i++) {
            int min = Math.min(next2, Math.min(next3, next5));
            dp[i] = min;
            
            if (min == next2) {
                p2++;
                next2 = dp[p2] * 2;
            }
            if (min == next3) {
                p3++;
                next3 = dp[p3] * 3;
            }
            if (min == next5) {
                p5++;
                next5 = dp[p5] * 5;
            }
        }
        
        return dp[n - 1];
    }
}
