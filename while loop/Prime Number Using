public class Main {
    public static void main(String[] args) {

        int num = 29;
        int i = 2;
        boolean prime = true;

        while (i <= num / 2) {
            if (num % i == 0) {
                prime = false;
                break;
            }
            i++;
        }

        if (prime && num > 1)
            System.out.println("Prime");
        else
            System.out.println("Not Prime");
    }
}
