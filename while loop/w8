
#include <stdio.h>
int main() {
    int n, i = 0, x;
    int m = 0, max = 0;
    scanf("%d", &n);
    while (i < n) {
        scanf("%d", &x);
        if (x == 0) {
            m++;
            if (m > max)
             max = m;
        } else
         m = 0;
        i++;
    }
    printf("%d", max);
}
